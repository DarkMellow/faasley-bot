# Copy this file to .env for local development. Never commit .env.

# Discord Developer Portal → your application → Bot → Reset Token
BOT_TOKEN=

# Discord Developer Portal → your application → General Information → Application ID
CLIENT_ID=

# Optional: a test server ID for `npm run deploy:guild` (instant command updates)
GUILD_ID=

# Optional locally, required in production: MongoDB connection string.
# Leave empty to use the local SQLite file (json.sqlite).
# Example (MongoDB Atlas): mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/faasle?retryWrites=true&w=majority
MONGODB_URI=
